# Public site URL (canonical / hreflang)
NEXT_PUBLIC_SITE_URL=https://example.com

# --- Admin mode ---------------------------------------------------------------
# Password for the key button in the footer and /admin. Required to sign in.
ADMIN_PASSWORD=
# Optional: separate secret for signing sessions (any long random string).
# Changing it (or the password) signs everyone out.
ADMIN_SECRET=
# Time zone for daily statistics.
ADMIN_TZ=Europe/Moscow
# Where analytics, edited texts and uploaded photos are stored (default: .data).
# Must be a persistent, writable folder on the server.
ICG_DATA_DIR=
# City database for geolocation on a plain server (default: .data/geo/city.mmdb).
# Fill it with `npm run geo:update`. Not needed on Vercel or behind Cloudflare.
GEOIP_DB=

# --- Telegram bot & leads (заявки) ----------------------------------------------
# Token from @BotFather. The bot runs as a webhook inside this site; connect it
# from /admin/leads → «Подключить бота», then link the managers' group there.
TELEGRAM_BOT_TOKEN=
# Optional: bot username (otherwise asked from Telegram), managers' group id
# (otherwise linked with /bind from the admin page), banner image for /start.
TELEGRAM_BOT_USERNAME=
TELEGRAM_GROUP_ID=
TELEGRAM_BANNER_URL=
# Base URL Telegram calls (e.g. https://icg-xi.vercel.app) when the custom domain sits behind a proxy.
TELEGRAM_WEBHOOK_BASE=
# Optional: enables the external API /api/v1/leads (Authorization: Bearer <key>, 16+ chars).
ICG_API_KEY=

# --- Static copy on GitHub Pages (npm run build:pages, .github/workflows/pages.yml) ---
# Pages (icg-xi.ru) are static files on GitHub; this Vercel server keeps the
# request form, statistics, the bot and admin mode.
# Server address for the bot's banner and "В админке" links (default: TELEGRAM_WEBHOOK_BASE).
SERVER_URL=
# Sites allowed to send the form and statistics here (default: icg-xi.ru, www.icg-xi.ru, misterharryx.github.io).
PUBLIC_SITE_ORIGINS=
# Optional: rebuild the Pages copy right after "Опубликовать" (otherwise within 10 minutes).
# Fine-grained GitHub token for the repository with "Contents: read and write".
GITHUB_PAGES_TOKEN=
GITHUB_PAGES_REPO=MisterHarryX/icg
